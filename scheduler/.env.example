# Copy to `.env` and tweak before running.
# APP_NAME=scheduler

# Worker pool
# NUM_WORKERS=2
# MAX_QUEUE_SIZE=1000

# The scheduler runs real inference through the inference-server model; set
# MODEL_PATH (and MODEL_BACKEND) pointing at the GGUF weights, e.g.:
# MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
# MODEL_BACKEND=local
