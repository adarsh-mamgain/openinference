# Copy to `.env` and set your real key before deploying.
API_KEY=dev-key

# Rate limiting (per key, per window)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Model backend: "local" (llama-cpp GGUF) or "mock" (echo fallback)
MODEL_BACKEND=local
MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_CTX=512
MODEL_THREADS=2
