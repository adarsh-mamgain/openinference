# Copy to `.env` and set your real key before deploying.
API_KEY=dev-key

# Rate limiting (per key, per window)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Chat model (llama-cpp GGUF instruct model)
MODEL_BACKEND=local
MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_IDENTIFIER=qwen2.5-0.5b-instruct
MODEL_CTX=512
MODEL_THREADS=2

# Embedding model (dedicated GGUF that supports embedding=True)
EMBEDDING_MODEL_PATH=models/nomic-embed-text-v1.5.Q8_0.gguf
EMBEDDING_MODEL_IDENTIFIER=nomic-embed-text-v1.5
EMBEDDING_MODEL_CTX=512

# Scheduler (internal request queue) worker pool
NUM_WORKERS=2
MAX_QUEUE_SIZE=1000
